# Application
NODE_ENV=development
PORT=3001              # Standardized API port (frontend uses 5173 via Vite)

# Database
# Do NOT put SSL parameters (sslmode/sslcert/sslkey/sslrootcert) in DATABASE_URL.
# SSL is controlled exclusively by DATABASE_SSL below. A URL containing any of
# those parameters is rejected at startup.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname

# Database SSL mode: require | disable (default: require)
#   require -> hosted PostgreSQL such as Neon (SSL enabled) — this is the secure default
#   disable -> local PostgreSQL without SSL (local development only)
DATABASE_SSL=require

# Local integration tests only: a SEPARATE database whose name ends in "_test".
# Tests drop and recreate its schema. Never point this at a shared or production database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/pmocore_test

# Logging
LOG_LEVEL=debug

# Browser origin(s) allowed to make state-changing requests (comma-separated).
# Required in production: the site the browser shows, e.g. https://pmocore.vercel.app
# (Vercel staging, which proxies /api to Render) — exact origin, no trailing slash.
APP_ORIGIN=http://localhost:5173

# true: in production this service also serves the built web app (single service).
# false: API only — the web app is hosted on Vercel (staging on free plans).
SERVE_WEB_APP=true

# Time zone used for "today" (overdue actions, next milestone).
APP_TIMEZONE=Asia/Manila

# Sessions (PostgreSQL-backed). SESSION_SECRET: random, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Attachments: local (development/tests), postgres (free-tier staging: private table
# in the database) or s3 (S3-compatible object storage such as Cloudflare R2)
ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_STORAGE_DIR=./.data/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_PURGE_DAYS=30
# postgres driver only: total attachment content allowed, in MiB (Neon Free: keep <= 400)
ATTACHMENT_DB_QUOTA_MB=300

# S3-compatible storage (required only when ATTACHMENT_STORAGE_DRIVER=s3)
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
